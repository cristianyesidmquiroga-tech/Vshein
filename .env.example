# Configuracion de Miss Lindas. Copia este archivo como .env y completa los valores.
# El .env real nunca se versiona (ya esta en .gitignore).
# Si falta SECRET_KEY o DATABASE_URL la app falla al arrancar con un error
# explicito, en vez de caer en un valor por defecto inseguro.

# Clave para firmar la cookie de sesion. Generar una unica y larga con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cadena de conexion a la base de datos.
#   Desarrollo local:  sqlite:///data/dev.sqlite3
#   Produccion:        postgresql+psycopg2://usuario:clave@host:5432/misslindas
DATABASE_URL=

# Prefijo no obvio bajo el que viven el login y el panel administrativo.
# Cambiarlo si se sospecha que quedo expuesto. Por defecto: equipo-sv
ADMIN_PATH_PREFIX=

# Solo true en desarrollo local, para poder correr `flask seed-demo-data`.
# En produccion debe quedar en false: crea usuarios con contrasenas conocidas.
SEED_DEMO_DATA=false

# development en tu maquina, production en el servidor.
# Controla si las cookies exigen HTTPS y si se envia la cabecera HSTS.
FLASK_ENV=development
